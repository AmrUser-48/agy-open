{
  "configVersion": 4,
  "sessionCompression": "gzip",
  "agentRole": "default",
  "modelProvider": "gemini",
  "cloudflareAccountID": "",
  "modelBaseURL": "http://127.0.0.1:11434/v1",
  "model": "gemini-3.8-flash-medium",
  "maxTurns": 0,
  "maxToolCalls": 0,
  "maxRunSeconds": 0,
  "maxWorkers": 3,
  "approvalMode": "ask",
  "theme": "dark",
  "colorScheme": "terminal",
  "altScreenMode": "never",
  "notifications": false,
  "showTips": true,
  "verbosity": "high",
  "runningLightSpeed": "medium",
  "showStatus": true,
  "trajectory": false,
  "mouseMode": false,
  "editor": "auto",
  "editorMode": "default",
  "enableTerminalSandbox": false,
  "allowNonWorkspaceAccess": false,
  "effort": "medium",
  "showThoughts": false,
  "systemPrompt": "",
  "safetySettings": [
    {
      "category": "HARM_CATEGORY_HARASSMENT",
      "threshold": "BLOCK_NONE"
    },
    {
      "category": "HARM_CATEGORY_HATE_SPEECH",
      "threshold": "BLOCK_NONE"
    },
    {
      "category": "HARM_CATEGORY_SEXUALLY_EXPLICIT",
      "threshold": "BLOCK_NONE"
    },
    {
      "category": "HARM_CATEGORY_DANGEROUS_CONTENT",
      "threshold": "BLOCK_NONE"
    }
  ],
  "approvalRules": [],
  "hotkeys": {
    "submit": "ENTER",
    "insertNewline": "CTRL-J",
    "interrupt": "CTRL-C",
    "forwardDelete": "CTRL-D",
    "clearScreen": "CTRL-L",
    "lineStart": "CTRL-A",
    "lineEnd": "CTRL-E",
    "cursorLeft": "CTRL-B",
    "cursorRight": "CTRL-F",
    "deletePreviousWord": "CTRL-W",
    "deleteNextWord": "ALT-D",
    "killLineStart": "CTRL-U",
    "killLineEnd": "CTRL-K",
    "yank": "CTRL-Y",
    "transpose": "CTRL-T",
    "externalEditor": "CTRL-G",
    "paste": "CTRL-V",
    "openShell": "CTRL-O",
    "toggleTrajectory": "ALT-O",
    "showDiff": "CTRL-R",
    "toggleMouse": "CTRL-S",
    "undo": "ALT-Z",
    "redo": "ALT-Y",
    "complete": "TAB",
    "cursorUp": "UP",
    "cursorDown": "DOWN",
    "historyPrevious": "CTRL-P",
    "historyNext": "CTRL-N",
    "pageUp": "PUP",
    "pageDown": "PDOWN",
    "home": "HOME",
    "end": "END",
    "wordBackward": "ALT-B",
    "wordForward": "ALT-F",
    "wordDeleteBackward": "ALT-BACKSPACE",
    "permissionMode": "SHIFT-TAB",
    "shiftEnter": "SHIFT-ENTER"
  },
  "groqRPM": 0,
  "groqTPM": 0,
  "groqMaxOutputTokens": 2048,
  "groqRetryOn429": true,
  "groqMaxBackoff": 30
}
